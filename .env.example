# VOLDBASE configuration template.
#
# Copy to `.env` for local use. `.env` is git-ignored; never commit real values.
# Unknown variables are ignored rather than treated as errors.

# Root directory for local state (ADR-0004, ADR-0009).
# Phase 1 reads this variable; everything else below is reserved and NOT read yet.
# Accepts an absolute path, a relative path, or `~/...`.
# Defaults to `$HOME/.voldbase` when unset.
#
#   VOLDBASE_HOME=/tmp/voldbase-dev voldbase list
#
VOLDBASE_HOME=

# --- Reserved, not read in Phase 1 -----------------------------------------

# Log verbosity: debug | info | warn | error.
VOLDBASE_LOG_LEVEL=info

# Optional token for private GitHub imports. No GitHub integration exists yet.
GITHUB_TOKEN=

# Execution backend selector.
# Intentionally commented out: no executor exists (ADR-0005).
# Do not enable until an isolation design is implemented and reviewed.
# VOLDBASE_EXECUTOR=
