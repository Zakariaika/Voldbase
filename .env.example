# VOLDBASE configuration template.
#
# Copy to `.env` for local use. `.env` is git-ignored; never commit real values.
#
# Phase 0 does not read these variables yet — they document the intended
# configuration surface so that adapters have a stable contract to implement.
# Unknown variables are ignored rather than treated as errors.

# Root directory for local state: database, artifacts and logs (ADR-0004).
# Defaults to `$HOME/.voldbase` when unset.
VOLDBASE_HOME=

# Log verbosity: debug | info | warn | error.
VOLDBASE_LOG_LEVEL=info

# Optional token used to import private GitHub repositories (Phase 1).
# Leave empty to use anonymous access for public repositories.
GITHUB_TOKEN=

# Execution backend selector.
# Intentionally commented out: no executor exists in Phase 0 (ADR-0005).
# Do not enable until an isolation design is implemented and reviewed.
# VOLDBASE_EXECUTOR=
