{
  "name": "voldbase",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "Universal Experiment & Verification Infrastructure for software and AI projects",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "voldbase": "./bin/voldbase.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
